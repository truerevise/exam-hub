rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function anonymousUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function superAdmin() {
      return signedIn() && request.auth.token.email in [
        'support@truerevise.com',
        'commercewithkiransingh@gmail.com',
        'kiransingh.smile@gmail.com'
      ];
    }
    function adminRecordExists() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email));
    }
    function adminRecord() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.token.email));
    }
    function hasPermission(permission) {
      return superAdmin()
        || (adminRecordExists() && permission in adminRecord().data.permissions);
    }
    function isAdmin() { return superAdmin() || adminRecordExists(); }
    function verificationSetting(field) {
      return exists(/databases/$(database)/documents/appSettings/verification)
        && get(/databases/$(database)/documents/appSettings/verification).data.get(field, false) == true;
    }
    function authEmailVerified() { return signedIn() && request.auth.token.email_verified == true; }
    function authPhoneVerified() { return signedIn() && request.auth.token.phone_number != null; }
    function verifiedUser() {
      return signedIn()
        && !anonymousUser()
        && (!verificationSetting('emailVerificationRequired') || authEmailVerified())
        && (!verificationSetting('mobileVerificationRequired') || authPhoneVerified());
    }
    function liveTestUser() { return anonymousUser() || verifiedUser(); }
    function studentDoc() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid));
    }
    function hasActivePass() {
      return signedIn()
        && studentDoc().data.get('premiumUntil', null) != null
        && studentDoc().data.premiumUntil > request.time;
    }
    function isFreeExam(examName) {
      return signedIn()
        && get(/databases/$(database)/documents/passSettings/freeExams).data.get(examName, false) == true;
    }
    function canAccessExam(examName) {
      return isAdmin() || (verifiedUser() && (hasActivePass() || isFreeExam(examName)));
    }
    function dailyQuestionAccess(questionId) {
      let accessPath = /databases/$(database)/documents/dailyQuestionAccess/$(questionId);
      return exists(accessPath)
        && get(accessPath).data.get('expiresAt', timestamp.date(1970, 1, 1)) > request.time;
    }
    function liveAttemptLimit(testId) {
      let accessPath = /databases/$(database)/documents/dailyLiveAccess/$(testId);
      let access = exists(accessPath) ? get(accessPath).data : {};
      let userPath = /databases/$(database)/documents/dailyLiveAccess/$(testId)/users/$(request.auth.uid);
      let userLimit = exists(userPath) ? get(userPath).data.get('attempts', 0) : 0;
      let group = exists(/databases/$(database)/documents/students/$(request.auth.uid))
        ? get(/databases/$(database)/documents/students/$(request.auth.uid)).data.get('group', '')
        : '';
      let groups = access.get('groupAttempts', {});
      let groupLimit = groups.get(group, 0);
      return userLimit > 0 ? userLimit : (groupLimit > 0 ? groupLimit : access.get('allAttempts', 1));
    }

    match /exams/{examId} {
      allow read: if signedIn() || hasPermission('questions');
      allow create, update, delete: if hasPermission('questions');
    }
    match /subjects/{subjectId} {
      allow read: if signedIn() || hasPermission('questions');
      allow create, update, delete: if hasPermission('questions');
    }
    match /passSettings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if superAdmin();
    }
    match /appSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if hasPermission('settings');
    }
    match /paymentOrders/{orderId} {
      allow read: if hasPermission('payments') || superAdmin();
      allow create, delete: if false;
      allow update: if superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','refundedAt','refundedBy','adminAction','adminActionAt'
        ])
        && request.resource.data.status == 'refunded';
    }
    match /questionReports/{reportId} {
      allow read: if hasPermission('questions') || superAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new';
      allow update: if hasPermission('questions') || superAdmin();
      allow delete: if false;
    }
    match /questions/{questionId} {
      allow get: if hasPermission('questions')
        || (signedIn() && dailyQuestionAccess(questionId))
        || (verifiedUser() && canAccessExam(resource.data.get('exam', '')));
      allow list: if hasPermission('questions') || signedIn();
      allow create, update, delete: if hasPermission('questions');
    }
    match /dailyQuestionAccess/{questionId} {
      allow read: if hasPermission('liveTests') || (verifiedUser() && resource.data.get('expiresAt', timestamp.date(1970, 1, 1)) > request.time);
      allow create, update, delete: if hasPermission('liveTests');
    }
    match /dailyLiveTests/{testId} {
      allow read: if true;
      allow create, update, delete: if hasPermission('liveTests');
    }
    match /dailyLiveAccess/{testId} {
      allow read: if signedIn();
      allow create, update, delete: if hasPermission('liveTests');
      match /users/{studentId} {
        allow read: if hasPermission('liveTests') || (signedIn() && request.auth.uid == studentId);
        allow create, update, delete: if hasPermission('liveTests');
      }
    }
    match /dailyAttempts/{attemptId} {
      allow read: if hasPermission('results')
        || (signedIn() && attemptId.matches('^' + request.auth.uid + '_.*$'));
      allow create: if liveTestUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.liveTestId is string
        && request.resource.data.attemptsUsed == 1
        && request.resource.data.attemptsUsed <= liveAttemptLimit(request.resource.data.liveTestId)
        && attemptId == request.auth.uid + '_' + request.resource.data.liveTestId;
      allow update: if liveTestUser()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.liveTestId == resource.data.liveTestId
        && request.resource.data.attemptsUsed == resource.data.attemptsUsed + 1
        && request.resource.data.attemptsUsed <= liveAttemptLimit(resource.data.liveTestId)
        && attemptId == request.auth.uid + '_' + resource.data.liveTestId;
      allow delete: if hasPermission('results') || superAdmin();
    }
    match /students/{studentId} {
      allow read: if hasPermission('students') || (signedIn() && request.auth.uid == studentId);
      allow create: if signedIn()
        && !anonymousUser()
        && request.auth.uid == studentId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.mobile is string
        && request.resource.data.mobile.matches('^\\+91[6-9][0-9]{9}$');
      allow update: if hasPermission('students')
        || (signedIn() && !anonymousUser() && request.auth.uid == studentId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photoURL','displayName','emailVerified','phoneVerified','verifiedAt','updatedAt']));
      allow delete: if hasPermission('students');
    }
    match /mobileRegistry/{mobileId} {
      allow read: if hasPermission('students') || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && !anonymousUser()
        && !exists(/databases/$(database)/documents/mobileRegistry/$(mobileId))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mobile == mobileId
        && mobileId.matches('^\\+91[6-9][0-9]{9}$');
      allow update, delete: if hasPermission('students');
    }
    match /results/{resultId} {
      allow read: if hasPermission('results')
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.get('isDailyLive', false));
      allow create: if liveTestUser()
        && request.resource.data.uid == request.auth.uid
        && (!request.resource.data.get('isDailyLive', false)
          || (request.resource.data.liveTestId is string
            && request.resource.data.attemptNo is int
            && getAfter(/databases/$(database)/documents/dailyAttempts/$(request.auth.uid + '_' + request.resource.data.liveTestId)).data.attemptsUsed == request.resource.data.attemptNo));
      allow update, delete: if hasPermission('results');
    }
    match /dailyLiveLeaderboard/{entryId} {
      allow read: if signedIn();
      allow create: if liveTestUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.liveTestId is string
        && entryId == request.auth.uid + '_' + request.resource.data.liveTestId;
      allow update: if liveTestUser()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.liveTestId == resource.data.liveTestId
        && request.resource.data.score >= resource.data.score;
      allow delete: if hasPermission('results');
    }
    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if hasPermission('settings');
    }
    match /auditLogs/{logId} {
      allow read: if hasPermission('audit') || superAdmin();
      allow create: if hasPermission('audit') || superAdmin();
      allow update, delete: if false;
    }
    match /savedQuestions/{savedId} {
      allow read: if hasPermission('questions') || (verifiedUser() && resource.data.uid == request.auth.uid);
      allow create: if verifiedUser() && request.resource.data.uid == request.auth.uid;
      allow update: if hasPermission('questions') || (verifiedUser() && request.auth.uid == resource.data.uid && request.resource.data.uid == request.auth.uid);
      allow delete: if hasPermission('questions') || (verifiedUser() && request.auth.uid == resource.data.uid);
    }
    match /students/{studentId}/savedQuestions/{savedId} {
      allow read, write: if hasPermission('questions') || (verifiedUser() && request.auth.uid == studentId);
    }
    match /adminUsers/{uid} {
      allow read: if superAdmin() || (signedIn() && request.auth.token.email == uid);
      allow write: if superAdmin();
    }
  }
}
