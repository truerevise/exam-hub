rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'kiransingh.smile@gmail.com';
    }

    match /exams/{examId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /dailyLiveTests/{testId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == studentId);
      allow create, update: if signedIn() && request.auth.uid == studentId;
      allow delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /savedQuestions/{savedId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /students/{studentId}/savedQuestions/{savedId} {
      allow read, write: if isAdmin()
        || (signedIn() && request.auth.uid == studentId);
    }

    // Unlisted collections remain denied by default.
  }
}
