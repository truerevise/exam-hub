rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'kiransingh.smile@gmail.com'; }
    function verificationSetting(field) {
      return exists(/databases/$(database)/documents/appSettings/verification)
        && get(/databases/$(database)/documents/appSettings/verification).data.get(field, false) == true;
    }
    function authEmailVerified() { return signedIn() && request.auth.token.email_verified == true; }
    function authPhoneVerified() { return signedIn() && request.auth.token.phone_number != null; }
    function verifiedUser() {
      return signedIn()
        && (!verificationSetting('emailVerificationRequired') || authEmailVerified())
        && (!verificationSetting('mobileVerificationRequired') || authPhoneVerified());
    }
    function studentDoc() { return get(/databases/$(database)/documents/students/$(request.auth.uid)); }
    function hasActivePass() {
      return signedIn()
        && studentDoc().data.get('premiumUntil', null) != null
        && studentDoc().data.premiumUntil > request.time;
    }
    function isFreeExam(examName) {
      return get(/databases/$(database)/documents/passSettings/main).data.freeExams.hasAny([examName]);
    }
    function canAccessExam(examName) { return isAdmin() || (verifiedUser() && (hasActivePass() || isFreeExam(examName))); }

    match /appSettings/verification {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /passSettings/{settingId} {
      allow read: if isAdmin() || verifiedUser();
      allow create, update, delete: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if isAdmin() || verifiedUser();
      allow create, update, delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isAdmin() || verifiedUser();
      allow create, update, delete: if isAdmin();
    }

    match /dailyLiveTests/{testId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /dailyAttempts/{attemptId} {
      allow read: if isAdmin() || (
        verifiedUser()
        && (!exists(/databases/$(database)/documents/dailyAttempts/$(attemptId))
            || resource.data.uid == request.auth.uid)
      );
      allow create: if verifiedUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.liveTestId is string
        && attemptId == request.auth.uid + '_' + request.resource.data.liveTestId
        && !exists(/databases/$(database)/documents/dailyAttempts/$(attemptId));
      allow update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == studentId);
      allow create: if signedIn()
        && request.auth.uid == studentId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.mobile is string
        && request.resource.data.mobile.matches('^\\+91[6-9][0-9]{9}$');
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == studentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photoURL','displayName','emailVerified','phoneVerified','verifiedAt','updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /mobileRegistry/{mobileId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/mobileRegistry/$(mobileId))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mobile == mobileId
        && mobileId.matches('^\\+91[6-9][0-9]{9}$');
      allow update, delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isAdmin() || (verifiedUser() && resource.data.uid == request.auth.uid);
      allow create: if verifiedUser() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // One public-safe leaderboard row per student per Daily Live Test.
    // Only the owner can create their own row; students can read rows so rank
    // can be calculated without exposing private result/solution documents.
    match /dailyLiveLeaderboard/{entryId} {
      allow read: if signedIn();
      allow create: if verifiedUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.liveTestId is string
        && entryId == request.auth.uid + '_' + request.resource.data.liveTestId;
      allow update, delete: if isAdmin();
    }

    match /savedQuestions/{savedId} {
      allow read: if isAdmin() || (verifiedUser() && resource.data.uid == request.auth.uid);
      allow create: if verifiedUser() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (verifiedUser() && request.auth.uid == request.resource.data.uid && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (verifiedUser() && request.auth.uid == request.resource.data.uid);
    }

    match /students/{studentId}/savedQuestions/{savedId} {
      allow read, write: if isAdmin() || (verifiedUser() && request.auth.uid == studentId);
    }
  }
}