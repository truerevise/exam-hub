rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Question and option images are publicly readable because they are shown
    // on student/test pages. Only designated Super Admin accounts may upload.
    match /question-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'support@truerevise.com',
          'commercewithkiransingh@gmail.com',
          'kiransingh.smile@gmail.com'
        ]
        && request.resource.size <= 10485760
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && request.auth.token.email in [
          'support@truerevise.com',
          'commercewithkiransingh@gmail.com',
          'kiransingh.smile@gmail.com'
        ];
    }

    // Deny all other Storage paths by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

// Deployment marker: 2026-08-23 image upload/admin alignment fix
