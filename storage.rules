rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Question and option images are publicly readable because they are shown
    // on student/test pages. Only the two designated super-admin accounts may upload.
    match /question-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'commercewithkiransingh@gmail.com',
          'kiransingh.smile@gmail.com'
        ]
        && request.resource.size <= 10485760;
      allow delete: if request.auth != null
        && request.auth.token.email in [
          'commercewithkiransingh@gmail.com',
          'kiransingh.smile@gmail.com'
        ];
    }

    // Deny all other Storage paths by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

// Deployment marker: 2026-08-22 storage upload fix verification
